# ReverseAI environment. Copy to .env and fill in. NEVER commit real secrets.

# --- model provider (server-side; never exposed to app users) ---------------
# deepseek | openai | anthropic | ollama | mock
REVERSEAI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- public hosting safety --------------------------------------------------
# REQUIRED before exposing the server to the internet. Users enter this token.
REVERSEAI_AUTH_TOKEN=
# Only API paths under these roots are allowed when auth is on.
# Colon-separated absolute paths. The store dir is always allowed; local mode
# (no token) also allows the current directory.
REVERSEAI_ALLOWED_ROOTS=
# Maximum upload size in MiB (default 512).
# REVERSEAI_UPLOAD_MAX_MB=512
# Hard ceiling on paid-model spend (USD). Paid models pause at the limit.
# REVERSEAI_MONTHLY_BUDGET=10
# Verification retries (default 3, max 10).
# REVERSEAI_MAX_REPAIR_ATTEMPTS=3
# Optional HMAC key for signed verification reports. Without it, reports use
# SHA-256 integrity only (tamper-evident, not keyed).
# REVERSEAI_REPORT_KEY=

# --- data + features --------------------------------------------------------
# REVERSEAI_STORE=./jobs
# REVERSEAI_SKILLS=./skills
# REVERSEAI_HOME=~/.reverseai

# --- research (optional) ----------------------------------------------------
# SearXNG-compatible JSON endpoint. Without it, DuckDuckGo HTML is used.
# REVERSEAI_SEARCH_URL=http://127.0.0.1:8888/search

# --- OCR (optional) ---------------------------------------------------------
# Baidu Unlimited-OCR behind vLLM/SGLang (OpenAI-compatible). Prefer this for
# long documents and PDFs; otherwise local Tesseract is used when installed.
# REVERSEAI_OCR_URL=http://127.0.0.1:10000
# REVERSEAI_OCR_MODEL=Unlimited-OCR
# REVERSEAI_OCR_MAX_TOKENS=32768

# --- high-risk capabilities (deny by default) -------------------------------
# Remote control, vault, payments, live desktop, persistent squads, MCP, and
# hooks are deliberately not implemented yet. Do not enable these unless you
# have read docs/SECURITY.md and accepted the risk. Both the master switch and
# the specific capability are required. A vault/payments also needs a key.
# REVERSEAI_ENABLE_DANGEROUS_CAPABILITIES=0
# REVERSEAI_ENABLE_REMOTE_CONTROL=0
# REVERSEAI_ENABLE_CREDENTIAL_VAULT=0
# REVERSEAI_ENABLE_PAYMENTS=0
# REVERSEAI_ENABLE_WORKSTATION=0
# REVERSEAI_ENABLE_SQUADS=0
# REVERSEAI_ENABLE_MCP=0
# REVERSEAI_ENABLE_HOOKS=0
# REVERSEAI_ENABLE_DEPLOYMENT=0
# REVERSEAI_ENABLE_SELF_TRAINING=0
# REVERSEAI_VAULT_KEY=
# Short-lived, single-use HMAC approvals for future irreversible actions.
# REVERSEAI_APPROVAL_KEY=

# --- sandbox hardening ------------------------------------------------------
# Keep the seccomp denylist on unless a target genuinely needs a denied syscall.
# REVERSEAI_SECCOMP=1

# --- gated remote/payment/training surfaces (all off by default) -----------
# Telegram is read-only and needs explicit chat pairing.
# REVERSEAI_TELEGRAM_TOKEN=
# REVERSEAI_TELEGRAM_CHATS=
# REVERSEAI_TELEGRAM_PAIRING=
# REVERSEAI_TELEGRAM_RATE=2
# MCP host-process transport is dangerous; keep this off.
# REVERSEAI_ALLOW_MCP_HOST=0
# REVERSEAI_HOOK_KEY=
# REVERSEAI_EXTENSION_KEY=
# QEMU surface: a kernel/rootfs alone is not a working guest runner.
# REVERSEAI_QEMU_KERNEL=
# REVERSEAI_QEMU_ROOTFS=
# REVERSEAI_QEMU_MEMORY_MB=512
# REVERSEAI_QEMU_CPUS=2
# Optional per-token monthly quotas. Zero means unlimited.
# REVERSEAI_QUOTA_RUNS=0
# REVERSEAI_QUOTA_TOKENS=0
# REVERSEAI_QUOTA_COST=0

# --- optional power-ups -----------------------------------------------------
# REVERSEAI_ALLOW_BROWSER_RENDER=0      # 1 enables headless Chromium cloning
# REVERSEAI_ALLOW_CODING_NETWORK=0      # 1 lets run_command reach the network
# REVERSEAI_GHIDRA=/opt/ghidra
# REVERSEAI_JDK=/usr/lib/jvm/java-21-openjdk-amd64
# REVERSEAI_QILING_ROOTFS=/path/to/rootfs

# --- provider keys ----------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# OLLAMA_MODEL=llama3.2
