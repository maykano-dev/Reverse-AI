{
  "name": "reverseai-desktop",
  "productName": "ReverseAI",
  "version": "0.9.0",
  "description": "Native desktop app for ReverseAI - understand, modify, rebuild.",
  "main": "main.js",
  "author": "ReverseAI",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:backend": "python3 -m PyInstaller backend/reverseai-server.spec --noconfirm --clean --distpath backend/dist --workpath backend/build",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "ai.reverse.desktop",
    "productName": "ReverseAI",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "loading.html", "assets/**/*"],
    "extraResources": [
      {
        "from": "backend/dist",
        "to": "backend",
        "filter": ["reverseai-server", "reverseai-server.exe"]
      }
    ],
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Development",
      "artifactName": "ReverseAI-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.developer-tools",
      "artifactName": "ReverseAI-${version}-${arch}.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "artifactName": "ReverseAI-${version}-${arch}.${ext}"
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
